{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@omnivox/shared": ["packages/shared/src/index.ts"],
      "@omnivox/security": ["packages/security/src/index.ts"],
      "@omnivox/wasm-audio": ["packages/wasm-audio/src/index.ts"]
    }
  }
}
