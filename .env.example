# Variables read by `docker compose --profile app up`.
# Copy to `.env` (gitignored) and fill in the values.

OPENAI_API_KEY=replace-with-your-openai-api-key
# Any long random string, e.g. `openssl rand -hex 32`.
SESSION_SECRET=replace-with-long-secret
# Optional: OpenAI-compatible endpoint instead of the default OpenAI API.
OPENAI_BASE_URL=

# Optional: real logins for the compose app profile (see docs/DEPLOYMENT.md).
# AUTH_MODE=keycloak
# KEYCLOAK_ISSUER_URL=http://host.docker.internal:8080/realms/omnivox
# KEYCLOAK_CLIENT_ID=omnivox-web
# KEYCLOAK_CLIENT_SECRET=omnivox-local-secret
