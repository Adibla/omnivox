S3_ENDPOINT=http://localhost:9000
# Browser-facing endpoint used to sign upload/read URLs. Leave empty when the
# browser reaches storage at the same URL as the server.
S3_PUBLIC_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=omnivox
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
S3_SERVER_SIDE_ENCRYPTION=
S3_CHECKSUM_ENABLED=true
S3_PRESIGN_TTL_SECONDS=300
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/omnivox
REDIS_URL=redis://localhost:6379
DEFAULT_TENANT_ID=default-tenant
OPENAI_API_KEY=replace-with-your-openai-api-key
OPENAI_BASE_URL=
OPENAI_ZDR_HEADER=x-openai-data-retention
OPENAI_ZDR_VALUE=zero-retention
MODEL_ASK=gpt-4o-mini
SESSION_SECRET=replace-with-long-secret
AUTH_MODE=disabled
APP_BASE_URL=http://localhost:3000
KEYCLOAK_ISSUER_URL=http://localhost:8080/realms/omnivox
KEYCLOAK_CLIENT_ID=omnivox-web
KEYCLOAK_CLIENT_SECRET=omnivox-local-secret
PIPELINE_TOKEN_BUDGET_PER_MEETING=24000
API_RATE_LIMIT_PER_MINUTE=120
