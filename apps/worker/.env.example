OPENAI_API_KEY=replace-with-your-openai-api-key
OPENAI_BASE_URL=
OPENAI_ZDR_HEADER=x-openai-data-retention
OPENAI_ZDR_VALUE=zero-retention
MODEL_TRANSCRIPTION=whisper-1
MODEL_PREPROCESS=gpt-5.4-mini
MODEL_REASONING=gpt-5.5
REDIS_URL=redis://localhost:6379
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/omnivox
# S3-compatible storage endpoint. The compose stack provides MinIO locally.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=omnivox
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
